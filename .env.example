# TMDb API Configuration
# Get your free API key at: https://www.themoviedb.org/settings/api

TMDB_API_KEY=your_TMDB_api_key_here

# GitHub Pages Configuration (for card generation)
# After making repository public, enable GitHub Pages in repository settings
# Your posters will be accessible at: https://YOUR_USERNAME.github.io/Filmster/game/posters/

GITHUB_USERNAME=your_github_username_here
